{
  "functions": {
    "api/*.py": {
      "maxDuration": 10,
      "excludeFiles": "{frontend/**,node_modules/**,backend/tests/**,**/__pycache__/**,**/*.pyc,README.md,STRUCTURE.md,.env*,.venv/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ]
}
