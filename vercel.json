{
  "functions": {
    "api/*.py": {
      "maxDuration": 10,
      "excludeFiles": "frontend/**|node_modules/**|backend/tests/**|**/__pycache__/**|**/*.pyc|README.md|STRUCTURE.md|.env*|.venv/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/frontend/dist/favicon.svg"
    },
    {
      "source": "/hero.png",
      "destination": "/frontend/dist/hero.png"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
